---
// Fonts come from Astro's Fonts API (see `fonts` in astro.config.ts and <Font /> in Layout.astro).
// Colour values are copied from the approved design's :root variables.
---

<style is:inline>
  :root {
    /* Marketing (AstroWind-style) palette */
    --aw-primary: #1f4f3d;
    --aw-accent: #2a6b52;
    --aw-text: #1c1b18;
    --aw-muted: #57544c;
    --aw-alt: #f2eee5;
    --aw-line: #e4ded1;
    --aw-paper: #faf8f3;
    --aw-ink: #1c1b18;

    /* Product palette (used inside product visuals only) */
    --surface: #f9f9f6;
    --white: #ffffff;
    --card-fill: #efefea;
    --border: #e6e6e0;
    --border-strong: #d4d4cc;
    --primary: #171c20;
    --secondary: #4a5460;
    --muted: #7d857c;
    --on-action: #ffffff;
    --action: #3b7a5c;
    --action-hover: #2d5a45;
    --action-soft: #e4efe9;
    --highlight: #d4962a;
    --highlight-soft: #fbf1dc;
    --brand: #5b5df0;
    --brand-hover: #4a4cd0;
    --brand-soft: #ecedfe;
    --success-bg: #e8f5ee;
    --success-bd: #c5e8d4;
    --success-fg: #2d5a45;
    --warning-bg: #fdf3e3;
    --warning-bd: #f0dfc0;
    --transfer: #5a6878;
    --transfer-soft: #e8ebee;

    /* AstroWind tokens mapped onto the design */
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-newsreader);
    --aw-font-heading: var(--font-newsreader);
    --aw-font-wordmark: var(--font-outfit);
    --aw-font-product: var(--font-geist);
    --aw-font-mono: var(--font-geist-mono);

    --aw-color-primary: var(--aw-primary);
    --aw-color-secondary: var(--aw-accent);
    --aw-color-accent: var(--aw-accent);
    --aw-color-link: var(--aw-primary);

    --aw-color-text-heading: var(--aw-text);
    --aw-color-text-default: var(--aw-text);
    --aw-color-text-muted: var(--aw-muted);
    --aw-color-bg-page: var(--aw-paper);

    ::selection {
      background-color: #d6e8de;
    }
  }
</style>
