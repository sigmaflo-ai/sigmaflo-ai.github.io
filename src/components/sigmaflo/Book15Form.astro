---
// Inline "Book 15 minutes" form. Posts to the existing Google Apps Script
// endpoint (same SHEET_URL as the previous site) with source "suiteworld-15min".
export interface Props {
  buttonText?: string;
}
const { buttonText = 'Book 15 minutes instead' } = Astro.props;
---

<form class="sf-book15" id="book-15" novalidate data-book15>
  <div class="sf-book15-row">
    <label class="sf-visually-hidden" for="book15-email">Work email</label>
    <input type="email" id="book15-email" name="email" placeholder="Work email" required autocomplete="email" inputmode="email" />
    <label class="sf-hp" aria-hidden="true">Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
    <button type="submit" class="btn btn-outline-light">{buttonText}</button>
  </div>
  <p class="sf-book15-msg" role="status" aria-live="polite"></p>
</form>

<script>
  const SHEET_URL =
    'https://script.google.com/macros/s/AKfycbyljUiyZ69iXSZb8U0hh1xd5sC35AoSxEYn2rwQeko9jM3AQ-Q6LqgynsROD3zQ7qQ/exec';

  const form = document.querySelector<HTMLFormElement>('[data-book15]');
  if (form) {
    const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const honeypot = form.querySelector<HTMLInputElement>('input[name="company"]');
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const msg = form.querySelector<HTMLElement>('.sf-book15-msg')!;

    const setMsg = (text: string) => {
      msg.textContent = text;
    };
    const markSent = () => {
      form.classList.add('is-sent');
      setMsg('Thanks — we’ll be in touch to set a time.');
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Spam check: a filled honeypot is silently treated as sent (same as before).
      if (honeypot && honeypot.value) {
        markSent();
        return;
      }

      const email = (emailInput.value || '').trim();
      if (!email || !emailInput.checkValidity()) {
        setMsg('Please enter your work email.');
        emailInput.focus();
        return;
      }

      btn.disabled = true;
      setMsg('Sending…');

      fetch(SHEET_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'suiteworld-15min' }),
      })
        .then(() => {
          emailInput.value = '';
          markSent();
        })
        .catch(() => {
          btn.disabled = false;
          setMsg('Something went wrong. Email hello@sigmaflo.ai and we’ll set it up.');
        });
    });

    // Every "Book 15 minutes" button scrolls to the form and focuses the email field.
    document.querySelectorAll<HTMLAnchorElement>('.js-book15').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        form.scrollIntoView({ behavior: 'smooth', block: 'center' });
        emailInput.focus({ preventScroll: true });
      });
    });
  }
</script>
