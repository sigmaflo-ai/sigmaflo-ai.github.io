---
import Layout from '~/layouts/PageLayout.astro';

export interface Props {
  title: string;
}
const { title } = Astro.props;

// Placeholder pages are kept out of search indexes until they have content.
const metadata = { title, robots: { index: false, follow: true } };
---

<Layout metadata={metadata}>
  <section class="sf-container sf-placeholder" aria-labelledby="page-title">
    <h1 id="page-title" class="sf-h2">{title}</h1>
    <p class="sf-lede">Coming soon</p>
  </section>
</Layout>
