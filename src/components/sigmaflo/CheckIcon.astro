---
export interface Props {
  class?: string;
  stroke?: string;
}
const { class: className, stroke = 'var(--action)' } = Astro.props;
---

<svg
  width="14"
  height="14"
  viewBox="0 0 14 14"
  fill="none"
  stroke={stroke}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}><path d="m3 7.5 2.5 2.5L11 4.5"></path></svg
>
