---
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import Metadata from '~/components/common/Metadata.astro';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection}>
  <head>
    <CommonMeta />
    <Favicons />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-outfit" />
    <Font cssVariable="--font-geist" />
    <Font cssVariable="--font-geist-mono" />
    <CustomStyles />
    <Metadata {...metadata} />

    <slot name="head" />
  </head>

  <body class="antialiased text-default bg-page min-h-screen flex flex-col">
    <a class="sf-skip-link" href="#main">Skip to content</a>
    <slot />

  </body>
</html>
